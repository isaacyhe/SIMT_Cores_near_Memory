     // virtual const SpecDef& get_supported_requests() = 0;
 
     virtual float get_tCK() { return -1.0f; };
+
+    // GPU_and_PNM (CAL energy): requests still held by the memory system, for the end-of-run drain (appended last).
+    virtual size_t vx_outstanding() { return 0; }
 };
 
 }        // namespace Ramulator
 
 
-#endif   // RAMULATOR_MEMORYSYSTEM_MEMORY_H
