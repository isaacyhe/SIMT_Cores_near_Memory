@@ -84,6 +84,12 @@ class GenericDRAMSystem final : public IMemorySystem, public Implementation {
       return m_dram->m_timing_vals("tCK_ps") / 1000.0f;
     }
 
+    size_t vx_outstanding() override {  // GPU_and_PNM: drain query, summed over channels
+      size_t n = 0;
+      for (auto controller : m_controllers) n += controller->vx_outstanding();
+      return n;
+    }
+
     // const SpecDef& get_supported_requests() override {
     //   return m_dram->m_requests;
     // };
diff --git a/src/memory_system/memory_system.h b/src/memory_system/memory_system.h
index beaf83c..dccfdeb 100644
--- a/src/memory_system/memory_system.h
+++ b/src/memory_system/memory_system.h
